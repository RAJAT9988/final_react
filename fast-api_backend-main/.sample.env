# Environment Configuration
PROJECT_NAME="FastAPI Modular Monolith"
ENVIRONMENT="development"
DEBUG=True

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="neha"
POSTGRES_PASSWORD="1234"
POSTGRES_DB="atomo_db"

# Database Connection URL (Async psycopg3)
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/atomo_db"

# User management / JWT (placeholders only — never commit real secrets)
JWT_SECRET_KEY="change-me-in-development-use-32b+"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_2FA_CHALLENGE_EXPIRE_MINUTES=5
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
